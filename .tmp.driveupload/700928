    BASE_RATE = 55  # $55/hour 고정값 [근거: Self-RAG]
    
    # 2. 점수 계산 로직
    time_loss = time_elapsed * BASE_RATE
    issue_loss = data_integrity_issues * 100 # 위반당 큰 페널티 부과 가정
    risk_multiplier = {"LOW": 1, "MEDIUM": 1.5, "HIGH": 2.5}.get(system_risk_level.upper(), 1)

    total_score = int((time_loss + issue_loss) * risk_multiplier)
    
    # 3. 상태 전이 및 보고서 생성 (State Machine Core)
    if total_score >= 5000:
        state = LossState.CRITICAL
        message = "🚨 CRITICAL ALERT: 데이터 무결성이 심각하게 손상되었습니다! 즉각적인 전문 컨설팅이 필요합니다."
    elif total_score >= 1500:
        state = LossState.WARNING
        message = "⚠️ WARNING: 잠재적 법적 리스크가 감지되었습니다. 추가 분석을 통해 비용을 최소화해야 합니다."
    else:
        state = LossState.SAFE
        message = "✅ SAFE: 현재까지의 데이터 관리는 양호합니다. 하지만 경계를 늦추지 마세요."

    # 상세 보고서 (Audit Trail)
    report = {
        "total_score": total_score,
        "current_state": state.value,
        "message": message,
        "breakdown": {
