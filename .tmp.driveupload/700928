def calculate_loss_score(time_elapsed: float, data_integrity_issues: int, system_risk_level: str = "LOW") -> Dict[str, Any]:
    """
    사용자의 현재 상황 데이터를 바탕으로 Loss Score를 계산하고 상태 전이를 결정합니다.
