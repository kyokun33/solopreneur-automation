<script>
    // Global Variables and Constants
    const TIME_VALUE = 55; // 시간당 가치 ($/hour) - Self-RAG 근거
    const THRESHOLD_WARNING = 1500; // $1,500 임계점 (Mini-Commitment Loop Trigger)
    const THRESHOLD_CRITICAL = 3000; // $3,000 임계점 (Critical State Trigger)

    // DOM Elements
    const timeLossInput = document.getElementById('time-loss');
    const riskCostInput = document.getElementById('risk-cost');
    const totalLossDisplay = document.getElementById('total-loss');
    const timeLossDisplay = document.getElementById('time-loss-display');
    const riskCostDisplay = document.getElementById('risk-cost-display');
    const ctaButton = document.getElementById('cta-button');
    const body = document.body;
    const lossScorecard = document.getElementById('loss-scorecard');
    const mainHookTitle = document.getElementById('main-hook-title');

    /**
     * 1. Loss Calculation Core Logic (Anti-Loss Funnel)
     */
    function calculateLoss(time, riskCost) {
        // Formula: Total Loss = (Time * Value/hr) + Risk Cost
        const timeLossAmount = Math.round(parseFloat(time) * TIME_VALUE);
        const totalLoss = Math.max(0, timeLossAmount + parseFloat(riskCost));
        return { timeLossAmount, totalLoss };
    }

    /**
     * 2. UI State Machine Update Function (The core interactive logic)
     */
    function updateLoss() {
        const time = parseFloat(timeLossInput.value) || 0;
        const riskCost = parseFloat(riskCostInput.value) || 0;

        // 1. Calculate Loss and Update Display
        const result = calculateLoss(time, riskCost);
        const totalLoss = Math.round(result.totalLoss);

        // Update Display Values
        totalLossDisplay.textContent = totalLoss.toLocaleString();
        timeLossDisplay.textContent = `${Math.round(result.timeLossAmount).toLocaleString()}원`; // Using Korean currency symbol for effect
        riskCostDisplay.textContent = `${Math.round(result.riskCost).toLocaleString()}원`;

        // 2. State Machine Logic (Color, Glitch, Text)
        resetState(); // Reset any previous state effects first

        if (totalLoss >= THRESHOLD_CRITICAL) {
            // Critical State: Loss > $3000
            applyCriticalState(totalLoss);
        } else if (totalLoss >= THRESHOLD_WARNING) {
            // Warning State: $1500 <= Loss < $3000
            applyWarningState(totalLoss);
        } else {
            // Safe/Low Risk State: Loss < $1500
            resetToSafeState();
        }

        // 3. Update CTA Button Copy based on loss amount
        updateCtaButton(totalLoss, time, riskCost);
    }

    /**
     * State Handlers
     */
    function applyWarningState(loss) {
        body.classList.add('warning-state');
        lossScorecard.classList.add('warning-state');
        mainHookTitle.textContent = `⚠️ 경고! 당신의 손실액은 이미 ${Math.round(THRESHOLD_WARNING / 100)}%를 초과했습니다.`;
        mainHookTitle.style.color = 'var(--warning-red)';
    }

    function applyCriticalState(loss) {
        body.classList.add('critical-state');
        lossScorecard.classList.add('critical-state');
        mainHookTitle.textContent = `🚨 CRITICAL! 손실액 ${Math.round(loss / 100)}% 초과, 즉시 조치가 필요합니다.`;
        mainHookTitle.style.color = '#B30000'; // Deeper Red for Critical
    }

    function resetToSafeState() {
        body.classList.remove('warning-state', 'critical-state');
        lossScorecard.classList.remove('warning-state', 'critical-state');
        mainHookTitle.textContent = `🚨 당신의 비즈니스, 지금 손실되고 있습니다.`;
        mainHookTitle.style.color = 'var(--tech-blue)';
    }

    function resetState() {
         // Remove state classes and glitch effect on input change
        body.classList.remove('warning-state', 'critical-state');
        lossScorecard.classList.remove('warning-state', 'critical-state');
        mainHookTitle.classList.remove('glitch-active');
    }


    /**
     * 3. CTA Button Logic (Mini-Commitment Loop)
     */
    function updateCtaButton(totalLoss, time, riskCost) {
        let buttonText;
        if (totalLoss === 0) {
            buttonText = "손실을 계산하고 해결책 찾기";
        } else if (totalLoss < THRESHOLD_WARNING * 0.8) {
             buttonText = `시간 확보 ${Math.round(time)}시간 돌려받기`; // Focus on Time Savings
        } else if (totalLoss >= THRESHOLD_WARNING && totalLoss < THRESHOLD_CRITICAL) {
            buttonText = `🔥 $1,500 손실 방지 진단 감사 신청하기`; // Funnel Trigger Point
        } else {
            buttonText = `🚨 긴급! 모든 리스크 차단 (최종 Audit)`; // Critical CTA
        }
        ctaButton.textContent = buttonText;

    }

    /**
     * 4. Simulated Purchase/Audit Flow (Final Action)
     */
    function simulatePurchase() {
        const totalLossValue = parseFloat(totalLossDisplay.textContent.replace(/,/g, ''));
        alert(`[System Alert] Anti-Loss Funnel Activated!\n\n당신의 현재 손실액 $${Math.round(totalLossValue)}에 대한 진단 요청을 접수했습니다.\n다음 단계: Mini-Commitment Loop (Paid Diagnostic Audit) 시작. ➡️ 결제 페이지로 이동합니다.`);
        // In a real scenario, this would redirect to the Payment/Audit page.
    }

    // Initialize the prototype on load
    window.onload = updateLoss;
</script>
