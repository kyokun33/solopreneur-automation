    if not data or 'time_elapsed' not in data or 'data_integrity_issues' not in data:
        raise ValueError("필수 입력값 (시간, 위반 횟수)이 누락되었습니다.")
    
    # 실제 계산 로직 호출
    result = calculate_loss_score(
        time_elapsed=data['time_elapsed'], 
        data_integrity_issues=int(data['data_integrity_issues']),
        system_risk_level=data.get('system_risk_level', 'LOW')
    )
